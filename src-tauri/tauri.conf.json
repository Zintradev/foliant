{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foliant",
  "version": "0.3.2",
  "identifier": "com.foliant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foliant",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "url": "app/index.html"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "$PICTURES/**",
          "$DOWNLOADS/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/file_icon.ico",
      "icons/file_icon.icns"
    ],
    "resources": [
      "icons/file_icon.ico",
      "icons/file_icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "foliant"
        ],
        "name": "Foliant Project",
        "description": "Foliant Studio Project File",
        "role": "Editor",
        "mimeType": "application/x-foliant"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "files": {
        "Resources/file_icon.icns": "icons/file_icon.icns"
      },
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNTdBMTVFNDY0RDZGQTMKUldTamIwMUdYcUZYQXFJSjZHekpCelRucnVnc3N1SDhpcmQzUzVic0R0MC9QcEcxSXcvNXZ4MGQK",
      "endpoints": [
        "https://github.com/Zintradev/foliant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}