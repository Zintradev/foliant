{
  "name": "foliant",
  "private": true,
  "version": "0.2.0-beta",
  "type": "module",
  "homepage": "https://Zintradev.github.io/foliant",
  "scripts": {
    "version": "node sync-version.cjs && cd src-tauri && cargo update -p foliant && cd .. && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "build:tauri": "tsc && vite build --mode tauri",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "check:ts": "tsc --noEmit",
    "check:rust-fmt": "cd src-tauri && cargo fmt -- --check",
    "check:rust-clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "check:rust-test": "cd src-tauri && cargo test",
    "check-all": "npm run check:ts && npm run test && npm run check:rust-fmt && npm run check:rust-clippy && npm run check:rust-test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/react-window": "^2.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.67.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^2.5.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "undici": "^8.12.4"
  }
}